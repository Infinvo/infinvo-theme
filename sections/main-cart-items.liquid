<style>
  .main-cart {
    padding: 30px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .cart-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--mela-indigo);
    margin-bottom: 30px;
  }
  .cart-empty {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }
  .cart-items {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 30px;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 20px;
    padding: 16px;
    border-bottom: 1px solid #e0e0e0;
    align-items: center;
  }
  .cart-item-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }
  .cart-item-info h3 {
    margin: 0 0 8px 0;
    color: var(--mela-indigo);
  }
  .cart-item-price {
    font-weight: 600;
  }
  .cart-summary {
    display: flex;
    justify-content: flex-end;
    gap: 30px;
    padding: 20px 0;
    border-top: 2px solid #e0e0e0;
  }
  .cart-summary-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .checkout-button {
    background-color: var(--mela-marigold);
    color: white;
    padding: 12px 32px;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<div class="main-cart">
  <h1 class="cart-title">Shopping Cart</h1>
  
  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <p>Your cart is empty</p>
      <a href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" class="cart-item-image">
            <div class="cart-item-info">
              <h3>{{ item.product.title }}</h3>
              <p>{{ item.variant.title }}</p>
              <div class="cart-item-price">₹{{ item.price | money_without_currency }} each</div>
            </div>
            <div>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              <button type="submit" name="update">Update</button>
            </div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cart-summary">
        <div class="cart-summary-item">
          <span>Subtotal:</span>
          <span>₹{{ cart.total_price | money_without_currency }}</span>
        </div>
        <button type="submit" class="checkout-button">Proceed to checkout</button>
      </div>
    </form>
  {% endif %}
</div>