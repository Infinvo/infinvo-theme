<style>
  .hero-banner {
    background-image: url('{{ section.settings.hero_image | image_url: width: 1200 }}');
    background-size: cover;
    background-position: center;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    margin: 20px;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.3);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 16px 0;
  }
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    margin: 0 0 24px 0;
  }
  .hero-cta {
    display: inline-block;
    background-color: var(--mela-marigold);
    color: white;
    padding: 12px 32px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
  }
  .hero-tiles {
    display: flex;
    gap: 20px;
    margin: 20px;
  }
  .hero-tile {
    flex: 1;
    aspect-ratio: 1;
    background-image: url('{{ section.settings.tile_image | image_url: width: 300 }}');
    background-size: cover;
    background-position: center;
    border-radius: 8px;
    cursor: pointer;
  }
</style>

<div class="hero-banner">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">{{ section.settings.title }}</h1>
    <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.cta_url }}" class="hero-cta">{{ section.settings.cta_text }}</a>
  </div>
</div>

<div class="hero-tiles">
  {% for block in section.blocks %}
    <a href="{{ block.settings.url }}" class="hero-tile" {{ block.shopify_attributes }}></a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Welcome to Mela"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover fashion & home treasures"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Shop now"
    },
    {
      "type": "image_picker",
      "id": "tile_image",
      "label": "Tile image"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}