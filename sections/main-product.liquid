<style>
  .main-product {
    padding: 30px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .product-image {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
  .product-image img {
    width: 100%;
    display: block;
  }
  .product-details h1 {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--mela-indigo);
    margin: 0 0 16px 0;
  }
  .product-rating {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 14px;
  }
  .product-price {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
    font-size: 18px;
  }
  .product-price-current {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--mela-indigo);
  }
  .product-price-original {
    text-decoration: line-through;
    color: #999;
  }
  .product-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .product-actions {
    display: flex;
    gap: 12px;
  }
  .product-quantity {
    display: flex;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 4px;
    width: fit-content;
  }
  .product-quantity button {
    background: none;
    border: none;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 16px;
  }
  .product-quantity input {
    width: 50px;
    border: none;
    text-align: center;
    font-size: 14px;
  }
  .add-to-cart {
    flex: 1;
    background-color: var(--mela-marigold);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    font-size: 16px;
  }
  @media (max-width: 768px) {
    .main-product {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="main-product">
  <div class="product-image">
    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
  </div>
  
  <div class="product-details">
    <h1>{{ product.title }}</h1>
    
    <div class="product-rating">
      {% if product.metafields.reviews.rating %}
        ⭐ {{ product.metafields.reviews.rating }} ({{ product.metafields.reviews.rating_count }} reviews)
      {% endif %}
    </div>
    
    <div class="product-price">
      <span class="product-price-current">₹{{ product.price | money_without_currency }}</span>
      {% if product.compare_at_price %}
        <span class="product-price-original">₹{{ product.compare_at_price | money_without_currency }}</span>
      {% endif %}
    </div>
    
    <div class="product-description">
      {{ product.description | strip_html }}
    </div>
    
    <form action="/cart/add" method="post">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      
      <div class="product-actions">
        <div class="product-quantity">
          <button type="button" onclick="this.parentNode.querySelector('input').stepDown();">−</button>
          <input type="number" name="quantity" value="1" min="1">
          <button type="button" onclick="this.parentNode.querySelector('input').stepUp();">+</button>
        </div>
        <button type="submit" class="add-to-cart">Add to cart</button>
      </div>
    </form>
  </div>
</div>