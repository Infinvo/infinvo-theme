<style>
  .product-grid-section {
    padding: 40px 20px;
    background-color: var(--mela-ivory);
  }
  .product-grid-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--mela-indigo);
    margin: 0 0 30px 0;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .view-all {
    text-align: center;
    margin-top: 30px;
  }
  .view-all-link {
    display: inline-block;
    background-color: var(--mela-marigold);
    color: white;
    padding: 12px 32px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s;
  }
  .view-all-link:hover {
    background-color: #e68a00;
  }
</style>

<div class="product-grid-section">
  <h2 class="product-grid-title">{{ section.settings.title }}</h2>
  
  {% if section.settings.collection %}
    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_count %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
    
    {% if section.settings.show_view_all %}
      <div class="view-all">
        <a href="{{ section.settings.collection.url }}" class="view-all-link">View all</a>
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}